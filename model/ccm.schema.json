       "columns"
      ],
      "additionalProperties": false,
      "properties": {
       "role": {
        "$ref": "#/$defs/ref"
       },
       "table": {
        "$ref": "#/$defs/ref"
       },
       "columns": {
        "type": "array",
        "minItems": 1,
        "items": {
         "$ref": "#/$defs/ref"
        }
       },
       "references": {
        "type": "array",
        "minItems": 1,
        "items": {
         "$ref": "#/$defs/ref"
        }
       },
       "enforced": {
        "type": "boolean",
        "default": false,
        "description": "Every value these columns hold is present in the columns they reference -- in `references` when it is given, otherwise in the target concept's identifier. It is a claim about the data, not about the catalogue: a declared foreign key is not enough, because 28% of the declared single-column foreign keys in a 90-database Spider sample are contradicted by their own rows. Where it holds the compiler may omit the join that checks the referent exists, and may read a referenced value from the column already in hand instead of joining for it. Absent, the compiler assumes nothing and joins."
       }
      }
     }
    }
   }
