 "derivationRules": [
  {"id": "dr.CzechGasstation", "target": {"kind": "subtype", "ref": "et.CzechGasstation"},
   "source": "Gasstation [has GasstationCountry: 'CZE']"},
  {"id": "dr.EuroPayingCustomer", "target": {"kind": "subtype", "ref": "et.EuroPayingCustomer"},
   "source": "Customer [has CustomerCurrency: 'EUR']"},
  {"id": "dr.CustomerHasAnnualConsumption",
   "target": {"kind": "factType", "ref": "ft.CustomerHasAnnualConsumption"},
   "source": "LIST c, yr, t FROM Yearmonth ym has Customer c AND ALSO has YearmonthDate d AND ALSO substr(d, 1, 4) AS yr AND ALSO has YearmonthConsumption v AND ALSO THE SUM OF v GROUPED BY c, yr AS t"},
  {"id": "dr.CustomerHasAnnualAverageConsumption",
   "target": {"kind": "factType", "ref": "ft.CustomerHasAnnualAverageConsumption"},
   "source": "LIST c, yr, t FROM Yearmonth ym has Customer c AND ALSO has YearmonthDate d AND ALSO substr(d, 1, 4) AS yr AND ALSO has YearmonthConsumption v AND ALSO THE AVERAGE v GROUPED BY c, yr AS t"}
 ],
